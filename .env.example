DJANGO_SETTINGS_MODULE=core.settings
DJANGO_ENV=production
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
POSTGRES_DB=nursekonnect
POSTGRES_USER=nursekonnect
POSTGRES_PASSWORD=nursekonnect
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
MAX_LOCATION_AGE_MINUTES=15
NEARBY_NURSE_RADIUS_KM=100
NEARBY_NURSE_CANDIDATE_LIMIT=50
OSRM_BASE_URL=http://router.project-osrm.org
OSRM_REQUEST_TIMEOUT_SECONDS=5
