DJANGO_SETTINGS_MODULE=core.settings
DJANGO_ENV=production
DJANGO_SECRET_KEY=change-me
MEDICAL_DATA_FERNET_KEY=generate-a-fernet-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
POSTGRES_DB=nursekonnect
POSTGRES_USER=nursekonnect
POSTGRES_PASSWORD=nursekonnect
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
DRF_ANON_THROTTLE_RATE=100/hour
DRF_USER_THROTTLE_RATE=1000/hour
DRF_AUTH_REGISTER_THROTTLE_RATE=10/hour
DRF_AUTH_LOGIN_THROTTLE_RATE=20/hour
DRF_AUTH_REFRESH_THROTTLE_RATE=60/hour
DRF_AUTH_LOGOUT_THROTTLE_RATE=60/hour
DRF_OTP_VERIFY_THROTTLE_RATE=10/hour
DRF_OTP_RESEND_THROTTLE_RATE=5/hour
MAX_LOCATION_AGE_MINUTES=15
NEARBY_NURSE_RADIUS_KM=100
NEARBY_NURSE_CANDIDATE_LIMIT=50
MATCHING_NOTIFICATION_BATCH_SIZE=5
MATCHING_RADIUS_STEPS_KM=10,20,50,100
REQUEST_OFFER_EXPIRY_MINUTES=2
TRACKING_MIN_INTERVAL_SECONDS=30
TRACKING_MAX_INTERVAL_SECONDS=60
ARRIVAL_VERIFICATION_DISTANCE_METERS=100
JOURNEY_WARNING_AFTER_MINUTES=30
JOURNEY_CANCEL_AFTER_MINUTES=60
OSRM_BASE_URL=http://router.project-osrm.org
OSRM_REQUEST_TIMEOUT_SECONDS=5
